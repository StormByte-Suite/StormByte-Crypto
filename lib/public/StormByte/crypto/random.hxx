#pragma once

#include <StormByte/byte_size.hxx>
#include <StormByte/crypto/random/exception.hxx>
#include <StormByte/crypto/visibility.h>
#include <StormByte/safe/secure_binary.hxx>
#include <StormByte/safe/string.hxx>
#include <StormByte/size.hxx>

/**
 * @namespace StormByte
 * @brief Root namespace of the StormByte suite.
 */
namespace StormByte {
	/**
	 * @namespace StormByte::Crypto
	 * @brief Crypto module of the StormByte suite.
	 */
	namespace Crypto {
		/**
		 * @namespace StormByte::Crypto::Random
		 * @brief Cryptographically secure random bytes and printable text.
		 *
		 * Calls use the existing per-thread cryptographic generator. Bytes use
		 * auto-wiped secure storage; Text returns ordinary, non-wiped text.
		 */
		namespace Random {
			/**
			 * @brief Generate exactly the requested number of random octets.
			 * @param count Number of bytes. Must be greater than zero.
			 * @return Independently owned, fully generated bytes in auto-wiped storage.
			 * @throws Exception The count is zero or the cryptographic provider failed.
			 * @note Allocation errors propagate unchanged. No partial result is
			 * returned on failure; temporary provider storage is securely wiped.
			 * Memory locking is best effort, not a guarantee against swapping.
			 * Moving or swapping the result into a plain Safe::Binary loses its
			 * wiping and locking guarantees; copies through borrowed views are
			 * the caller's responsibility.
			 */
			STORMBYTE_CRYPTO_PUBLIC Safe::SecureBinary Bytes(ByteSize count);

			/**
			 * @brief Generate uniformly distributed printable ASCII characters.
			 * @param count Number of characters. Must be greater than zero.
			 * @return Independently owned text of exactly @p count characters in
			 * ASCII 33 through 126 inclusive (no spaces or embedded NUL).
			 * @throws Exception The count is zero or the cryptographic provider failed.
			 * @note Sampling is unbiased. Allocation errors propagate unchanged.
			 * No partial result is returned on failure; temporary provider storage
			 * is securely wiped. The trailing NUL is not part of the length.
			 * Returned text is not automatically wiped or memory-locked.
			 */
			STORMBYTE_CRYPTO_PUBLIC Safe::String Text(Size count);
		}
	}
}
